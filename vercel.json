{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "admin-portal": {
      "root": "apps/admin-portal",
      "framework": "nextjs"
    },
    "hub-courier-portal": {
      "root": "apps/hub-courier-portal",
      "framework": "nextjs"
    },
    "nuxt-storefront": {
      "root": "apps/nuxt-storefront",
      "framework": "nuxtjs",
      "outputDirectory": "dist"
    },
    "seller-portal": {
      "root": "apps/seller-portal",
      "framework": "nextjs"
    },
    "web-storefront": {
      "root": "apps/web-storefront",
      "framework": "nextjs"
    }
  },
  "rewrites": [
    {
      "source": "/admin/(.*)",
      "destination": {
        "service": "admin-portal"
      }
    },
    {
      "source": "/admin",
      "destination": {
        "service": "admin-portal"
      }
    },
    {
      "source": "/seller/(.*)",
      "destination": {
        "service": "seller-portal"
      }
    },
    {
      "source": "/seller",
      "destination": {
        "service": "seller-portal"
      }
    },
    {
      "source": "/hub/(.*)",
      "destination": {
        "service": "hub-courier-portal"
      }
    },
    {
      "source": "/hub",
      "destination": {
        "service": "hub-courier-portal"
      }
    },
    {
      "source": "/regional/(.*)",
      "destination": {
        "service": "nuxt-storefront"
      }
    },
    {
      "source": "/regional",
      "destination": {
        "service": "nuxt-storefront"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web-storefront"
      }
    }
  ]
}
