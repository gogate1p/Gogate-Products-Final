{
  "name": "nuxt-storefront",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build && node -e \"const fs=require('fs'); if(!fs.existsSync('dist')){fs.cpSync('.output/public','dist',{recursive:true});}\"",
    "dev": "nuxt dev -p 3004",
    "generate": "nuxt generate",
    "preview": "nuxt preview"
  },
  "dependencies": {
    "@gogate/shared-types": "workspace:*",
    "@gogate/logistics-engine": "workspace:*",
    "@gogate/payment-engine": "workspace:*",
    "nuxt": "^3.16.0",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@nuxtjs/tailwindcss": "^6.13.1"
  }
}
